{
  "name": "@gantt-planner/engine",
  "version": "0.0.1",
  "description": "Pure TypeScript project scheduling engine: calendars, dependencies (FS/SS/FF/SF + lag), constraints, CPM forward/backward pass, slack and critical path",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
