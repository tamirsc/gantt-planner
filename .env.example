# Server configuration (packages/server). Copy to .env for local development.
PORT=3000
# Postgres connection string. When unset, an embedded PGlite database is used (./data/pglite).
DATABASE_URL=postgres://user:password@host:5432/gantt
# Random secret for signing cookies (required in production): openssl rand -base64 32
COOKIE_SECRET=
# Allowed browser origin for the API when the web app is served from another host (dev: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
